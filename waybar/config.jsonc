{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": 1,

  "margin-top": 0,
  "margin-left": 12,
  "margin-right": 12,

  "spacing": 8,

  "modules-left": [
    "hyprland/workspaces"
  ],
    
  "modules-center": [
    "clock"
  ],

  "modules-right": [
	"custom/media",
	"tray",
	"custom/mic",
	"pulseaudio",
	"network",
	"custom/power"
  ],

  "hyprland/workspaces": {
       "format": "{name} {windows}",
       "workspace-taskbar": {
           "enable": true,
           "format": "{icon}",
        /*   "icon-size": 16,*/
           "icon-theme": "adwaita"
       }
   },
  
  "clock": {
    "format": "{:%a %I:%M %p}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>",
    "interval": 1
  },

  "custom/media": {
  	"exec": "~/.config/waybar/scripts/playerctl.sh",
  	"return-type": "json",
  	"interval": 1,
  	"on-click": "playerctl play-pause",
  	"on-scroll-up": "playerctl next",
  	"on-scroll-down": "playerctl previous"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  },

  "network": {
    "format-ethernet": "󰌗 ",
    "format-disconnected": "󰌙 ",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": [
        "",
        " ",
        " "
      ]
    },
    "on-click": "pavucontrol"
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/waybar/scripts/mic-toggle.sh"
  },

  "tray": {
    "spacing": 10
  }
}
